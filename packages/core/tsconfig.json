{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ESNext",
    "baseUrl": ".",
    "paths": {
        "@astro": ["./src/astro"],
        "@astro/*": ["./src/astro/*"],
        "@jpl": ["./src/jpl"],
        "@jpl/*": ["./src/jpl/*"],
      }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
