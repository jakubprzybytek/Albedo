{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ESNext",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@astro": ["./src/astro"],
      "@astro/*": ["./src/astro/*"],
      "@jpl": ["./src/jpl"],
      "@jpl/*": ["./src/jpl/*"],
      "@openNgc": ["./src/openNgc"],
      "@openNgc/*": ["./src/openNgc/*"],
      "@utils/*": ["./src/utils/*"],
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
