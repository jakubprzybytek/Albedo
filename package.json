{
  "name": "albedo",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "build": "npm run typecheck && npm run build --workspace albedo-web",
    "test": "vitest",
    "test:e2e": "npm run test:e2e --prefix ./packages/web",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "sst:version": "sst version",
    "infra:diff": "sst diff",
    "typecheck": "tsc --noEmit",
    "listSpk": "npm run listSpk --prefix ./packages/core",
    "listPck": "npm run listPck --prefix ./packages/core"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "sst": "4.17.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@tsconfig/node20": "^20.1.5"
  }
}
